# Copy to /opt/image-optimizer/.env on the server and fill in the values.
# Keep this file private: chmod 600, and never commit it.

APP_ENV=production
FLASK_SECRET_KEY=paste-a-long-random-value        # python3 -c "import secrets; print(secrets.token_hex(32))"

# The One Globe FZE app (Dev Dashboard -> your app -> Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://206-81-12-41.sslip.io            # no trailing slash. Change it if you get your own domain
SHOPIFY_SCOPES=write_products
SHOPIFY_API_VERSION=2026-07

# Real money only moves when this is false. Leave true until payments are tested end to end.
SHOPIFY_BILLING_TEST=true

SHOP_DB_PATH=/var/lib/image-optimizer/shops.db
U2NET_HOME=/var/lib/image-optimizer/u2net          # where the background-removal model is stored

GEMINI_API_KEY=

# Shown on the privacy and support pages
COMPANY_NAME=One Globe FZE
SUPPORT_EMAIL=

# Set to true once the theme extension has been deployed
SPEED_EXTENSION_LIVE=true

# NEVER put these on the server (they are for local testing only):
#   SHOPIFY_STORE_DOMAIN, SHOPIFY_ACCESS_TOKEN, FLASK_DEBUG
