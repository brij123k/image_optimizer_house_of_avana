[Unit]
Description=image-optimizer (Flask app under gunicorn)
After=network.target

[Service]
User=imageopt
Group=imageopt
WorkingDirectory=/opt/image-optimizer
EnvironmentFile=/opt/image-optimizer/.env
ExecStart=/opt/image-optimizer/venv/bin/gunicorn -c deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=3
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
