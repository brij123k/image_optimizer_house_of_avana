SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Required for the OAuth install flow (shopify_auth.py) — from your app's
# settings in the Shopify Partner dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public base URL this app is reachable at, no trailing slash, e.g.
# https://your-app.example.com — used to build the OAuth redirect/webhook URLs.
SHOPIFY_APP_URL=
SHOPIFY_SCOPES=read_products,write_products

# Signs Flask's session cookie (OAuth nonce, logged-in shop). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Where the per-shop token database lives (token_store.py, billing_store.py).
SHOP_DB_PATH=shops.db

# Image-pack purchases (billing.py) go through Shopify's Billing API. Leave
# this as "true" during development — it uses Shopify's test-charge mode, so
# nothing is actually billed. Set to "false" only once you're ready to take
# real payments in production.
SHOPIFY_BILLING_TEST=true

# AI-generated ALT text / filenames (ai_metadata.py) — a Gemini API key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local development only. On the live server use APP_ENV=production and see deploy/.env.production.example
APP_ENV=development
FLASK_DEBUG=1
COMPANY_NAME=One Globe FZE
SUPPORT_EMAIL=
